<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>CSS Units</title>
  <style>
    .box-px { width: 200px; height: 40px; background-color: #dbeafe; margin-bottom: 8px; }
    .box-pct { width: 50%; height: 40px; background-color: #dcfce7; margin-bottom: 8px; }
    p { font-size: 1.5rem; }
  </style>
</head>
<body>
  <div class="box-px">200px × 40px</div>
  <div class="box-pct">50% × 40px</div>
  <p>Paragraph sized at 1.5rem.</p>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Responsive Typography</title>
  <style>
    body { font-size: 1rem; }
    h1 { font-size: 1.5rem; }
    @media (min-width: 600px) {
      h1 { font-size: 2.5rem; }
    }
  </style>
</head>
<body>
  <h1>Scalable Heading</h1>
  <p>Body text stays at 1rem while the heading scales with viewport width.</p>
</body>
</html>
